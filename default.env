ENV_VERSION=2

# Local-dev overlay. Production inventory overrides this to
# "adi.yml:ext-network.yml" (Traefik path, no localhost binding).
COMPOSE_FILE=adi.yml:rpc-shared.yml

PROJECT_NAME=adi

# Network: mainnet (testnet not currently supported in this repo)
NETWORK=mainnet

# ADI mainnet chain ID = 36900 = 0x9024
CHAIN_ID=36900

# =============================================================================
# Docker images — pin versioned tags, never use latest
# =============================================================================

# External node — pinned to ADI's public Harbor image
# BCE-11659: repo path changed with the v0.20.12 P2P upgrade (was
# adi-public/chain/external-node); both paths are anonymously pullable.
NODE_DOCKER_REPO=harbor.sde.adifoundation.ai/ghpc/adi-foundation-labs/server
NODE_DOCKER_TAG=v0.20.12-b1

# =============================================================================
# Ports
# =============================================================================

# JSON-RPC HTTP + WebSocket (ADI multiplexes both on a single port)
RPC_PORT=3050
# Status / health server
STATUS_PORT=3071
# P2P (devp2p) — replaces the old HTTP block-replay transport (v0.20.12+).
# Must be reachable directly on the host; not proxied by Traefik.
NETWORK_PORT=3060
# Prometheus metrics
METRICS_PORT=3312

# =============================================================================
# ADI configuration
# =============================================================================

# Required: archive Ethereum L1 RPC. Pruned L1 panics with
# "state at block is pruned". Set per host in ansible inventory.
GENERAL_L1_RPC_URL=

# P2P identity key (64-char hex, `openssl rand -hex 32`). Unique per node —
# losing it means resyncing from scratch with a new identity. Set per host in
# ansible inventory (secret), never share between nodes.
EXTERNAL_NETWORK_SECRET_KEY=

# Boot node(s) for P2P peer discovery, provided by ADI per network.
BOOT_NODE_URLS=

# Public ADI RPC. Consumed by the external node as `general_main_node_rpc_url`
# (its upstream main node) and by `check_sync.sh` as the reference RPC for
# block-height comparison — for ADI these are always the same URL.
PUBLIC_RPC_URL=https://rpc.adifoundation.ai

# Genesis-derived contract addresses (do not change unless ADI rotates them)
BRIDGEHUB_ADDRESS=0x7a38c18a229ef8a0ae7104ba272a46280f2d59cb
BYTECODE_SUPPLIER_ADDRESS=0x6e369e616dd5a5cb0cd410f541c784033de89042

# Rust log filter (rolled up by external-node)
RUST_LOG=info,zksync_os_server=info,zksync_os_sequencer=info,zksync_os_merkle_tree=info,zksync_os_priority_tree=info,zksync_os_server::prover_api=info

# =============================================================================
# Traefik / Prometheus integration
# =============================================================================

DOCKER_EXT_NETWORK=traefik_default
DOMAIN=cryptomanufaktur.net
RPC_HOST=adi
RPC_LB=adi-lb
WS_HOST=adiws
WS_LB=adiws-lb

# =============================================================================
# Pinning
# =============================================================================

SCRIPT_TAG=
